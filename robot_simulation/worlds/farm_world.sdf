<?xml version="1.0"?>
<sdf version="1.8">
  <world name="farm_world">

    <!-- ── Physics ───────────────────────────────────────────────────── -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- ── Required world systems ────────────────────────────────────── -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <!-- ── Bright tropical sun ───────────────────────────────────────── -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>1.0 0.95 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.3 0.1 -0.95</direction>
    </light>

    <!-- Ambient sky fill -->
    <light type="directional" name="sky_fill">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>0.28 0.32 0.38 1</diffuse>
      <specular>0 0 0 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>1.0</constant>
        <linear>0.0</linear>
        <quadratic>0.0</quadratic>
      </attenuation>
      <direction>0.3 -0.1 -0.95</direction>
    </light>

    <!-- ── Ground plane (sandy farm soil) ───────────────────────────── -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode><mu>0.8</mu><mu2>0.8</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.55 0.45 0.28 1</ambient>
            <diffuse>0.62 0.52 0.32 1</diffuse>
            <specular>0.05 0.05 0.03 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         PALM TREES — 6 × 6 grid, 8 m row/column spacing
         X columns : −20, −12, −4, 4, 12, 20
         Y rows    : −20, −12, −4, 4, 12, 20
         Robot spawns at (0, 0) — always clear of every trunk.
         Each tree = brown trunk (cylinder) + green crown (sphere).
         Trunk collision only (no crown collision for sensor clarity).
         ================================================================ -->

    <!-- ROW y = -20 -->
    <model name="palm_r0_c0"><static>true</static><pose>-20 -20 0 0 0 0</pose>
      <link name="link">
        <collision name="tc"><pose>0 0 2.4 0 0 0</pose><geometry><cylinder><radius>0.22</radius><length>4.8</length></cylinder></geometry></collision>
        <visual name="tv"><pose>0 0 2.4 0 0 0</pose><geometry><cylinder><radius>0.22</radius><length>4.8</length></cylinder></geometry><material><ambient>0.40 0.26 0.12 1</ambient><diffuse>0.48 0.32 0.16 1</diffuse></material></visual>
        <visual name="cv"><pose>0 0 5.8 0 0 0</pose><geometry><sphere><radius>2.0</radius></sphere></geometry><material><ambient>0.10 0.38 0.10 1</ambient><diffuse>0.14 0.48 0.14 1</diffuse></material></visual>
      </link>
    </model>

    <model name="palm_r0_c1"><static>true</static><pose>-12 -20 0 0 0 0</pose>
      <link name="link">
        <collision name="tc"><pose>0 0 2.2 0 0 0</pose><geometry><cylinder><radius>0.22</radius><length>4.4</length></cylinder></geometry></collision>
        <visual name="tv"><pose>0 0 2.2 0 0 0</pose><geometry><cylinder><radius>0.22</radius><length>4.4</length></cylinder></geometry><material><ambient>0.40 0.26 0.12 1</ambient><diffuse>0.48 0.32 0.16 1</diffuse></material></visual>
        <visual name="cv"><pose>0 0 5.3 0 0 0</pose><geometry><sphere><radius>1.9</radius></sphere></geometry><material><ambient>0.12 0.40 0.10 1</ambient><diffuse>0.16 0.50 0.14 1</diffuse></material></visual>
      </link>
    </model>

    <model name="palm_r0_c2"><static>true</static><pose>-4 -20 0 0 0 0</pose>
      <link name="link">
        <collision name="tc"><pose>0 0 2.5 0 0 0</pose><geometry><cylinder><radius>0.24</radius><length>5.0</length></cylinder></geometry></collision>
        <visual name="tv"><pose>0 0 2.5 0 0 0</pose><geometry><cylinder><radius>0.24</radius><length>5.0</length></cylinder></geometry><material><ambient>0.38 0.25 0.11 1</ambient><diffuse>0.46 0.31 0.15 1</diffuse></material></visual>
        <visual name="cv"><pose>0 0 6.1 0 0 0</pose><geometry><sphere><radius>2.1</radius></sphere></geometry><material><ambient>0.10 0.36 0.10 1</ambient><diffuse>0.13 0.45 0.13 1</diffuse></material></visual>
      </link>
    </model>

    <model name="palm_r0_c3"><static>true</static><pose>4 -20 0 0 0 0</pose>
      <link name="link">
        <collision name="tc"><pose>0 0 2.3 0 0 0</pose><geometry><cylinder><radius>0.21</radius><length>4.6</length></cylinder></geometry></collision>
